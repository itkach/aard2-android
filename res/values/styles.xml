<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- App-wide themes, applied by Application.installTheme(). Parent must
         be an AppCompat-descended theme (Material3 qualifies, same as
         MaterialComponents before it): com.google.android.material.appbar.
         AppBarLayout enforces via ThemeEnforcement that the active theme
         resolves AppCompat-defined attributes (e.g. colorPrimary), throwing
         IllegalArgumentException ("...requires your app theme to be
         Theme.AppCompat...") otherwise - true regardless of windowActionBar,
         and regardless of the Activity's Java class (this doesn't require
         AppCompatActivity, only the theme resource matters). NoActionBar
         parents already set windowActionBar=false/windowNoTitle=true, so no
         manual overrides are needed - both activities host their own
         Toolbar directly.

         DynamicColors parents (bundled in the material library we already
         depend on) supply every color role themselves: on Android 12+ from
         the system's own Material You palette (derived from the user's
         wallpaper, the same colors every other app on the device picks up),
         and on older versions by falling back to Material 3's own baseline
         palette - both via a plain theme-parent switch, no color values of
         our own needed at all. This replaces an earlier version of this
         theme that hand-generated a full color scheme from a single seed
         color and listed every role explicitly (see git history) - a
         reasonable approach in isolation, but unnecessary work once a
         system-provided equivalent exists, and one that would never have
         matched the system's own theme the way this now does. -->
    <!-- windowActionModeOverlay=true draws a contextual ActionMode (multi-select
         bar, find-in-page) OVER the content's top instead of inserting it and
         pushing everything down. Without it the app had to hide its own Toolbar
         for the ActionMode's duration to avoid a stacked double bar, and that
         hide/show desynced from the ActionMode's own enter/exit animation,
         causing a visible layout shift. With the overlay the Toolbar stays put
         (covered by the bar) and nothing reflows. -->
    <!-- actionBarSize drives the contextual ActionMode bars' height (multi-select
         and find-in-page). The main Toolbar sets its own @dimen/toolbar_height and
         so ignores this, but the ActionMode bars don't - point both at the same
         dimen so they match the slimmer Toolbar instead of the 56dp default. -->
    <style name="Theme.Aard2" parent="@style/Theme.Material3.DynamicColors.Light.NoActionBar">
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:actionBarSize">@dimen/toolbar_height</item>
        <item name="actionBarSize">@dimen/toolbar_height</item>
    </style>

    <style name="Theme.Aard2.Dark" parent="@style/Theme.Material3.DynamicColors.Dark.NoActionBar">
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:actionBarSize">@dimen/toolbar_height</item>
        <item name="actionBarSize">@dimen/toolbar_height</item>
    </style>

    <!-- Applied via android:theme on every <android.widget.Toolbar>. Its
         title/subtitle already get colorOnPrimary directly
         (titleTextColor/subtitleTextColor); this covers everything else
         hosted in the Toolbar that derives its color from these framework/
         MDC attributes instead - the overflow "⋮" icon and the up chevron
         (colorControlNormal), and a SearchView action view's hint text and
         clear icon (textColorSecondary/textColorHint/colorControlNormal) -
         none of which otherwise have any reason to contrast with
         colorPrimary. Uses ?attr/colorOnPrimary (not a literal color) so
         one overlay works for both Theme.Aard2 and Theme.Aard2.Dark - it
         resolves through to whichever is active. No parent: an
         android:theme overlay merges on top of the ambient theme, so
         anything not listed here still falls through unchanged. -->
    <style name="ThemeOverlay.Aard2.Toolbar" parent="@android:style/ThemeOverlay">
        <item name="colorControlNormal">?attr/colorOnPrimary</item>
        <item name="colorControlActivated">?attr/colorOnPrimary</item>
        <item name="android:textColorPrimary">?attr/colorOnPrimary</item>
        <item name="android:textColorSecondary">?attr/colorOnPrimary</item>
        <item name="android:textColorHint">?attr/colorOnPrimary</item>
    </style>

    <!-- android:popupTheme merges on top of the Toolbar's own android:theme
         overlay above (not the plain ambient activity theme), so an empty
         overlay is a no-op and popup menu text would otherwise stay
         colorOnPrimary (near-white) - illegible against the popup's own
         colorSurface background. colorOnSurface is the correct semantic
         role for text drawn on colorSurface. -->
    <style name="ThemeOverlay.Aard2.ToolbarPopup" parent="@android:style/ThemeOverlay">
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurface</item>
    </style>

    <!-- List-item text roles, replacing the layouts' old
         @android:style/TextAppearance.Holo.* references. Parented on the
         Material 3 type scale so size/weight/letter-spacing follow the active
         theme (and its dynamic color) rather than Holo. Titles inherit the
         type scale's own on-surface colour; the muted subtitle/caption roles
         use colorOnSurfaceVariant, M3's role for de-emphasised secondary text
         (the modern stand-in for the old textColorSecondary the Holo subtitle
         styles carried). Applied via style="..." exactly as the Holo ones
         were. -->
    <style name="TextAppearance.Aard2.ListTitle" parent="@style/TextAppearance.Material3.TitleMedium" />

    <style name="TextAppearance.Aard2.ListSubtitle" parent="@style/TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.Aard2.ListCaption" parent="@style/TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

</resources>
