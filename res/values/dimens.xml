<resources>

    <!-- Fixed-header Toolbar height for both activities - more compact than the
         platform's 56dp ?android:attr/actionBarSize. The Lookup SearchView is
         given an explicit 40dp height (see activity_main.xml) so it centres in
         this with breathing room rather than filling it and pushing its
         underline flush against the bottom edge. -->
    <dimen name="toolbar_height">48dp</dimen>

    <!-- Default sizes for Samsung multiwindow. -->
    <dimen name="app_defaultsize_w">632.0dip</dimen>
    <dimen name="app_defaultsize_h">598.0dip</dimen>
    <dimen name="app_minimumsize_w">632.0dip</dimen>
    <dimen name="app_minimumsize_h">598.0dip</dimen>

</resources>
