<resources>

    <!-- Default screen margins, per the Android Design guidelines. -->
    <dimen name="activity_horizontal_margin">16dp</dimen>
    <dimen name="activity_vertical_margin">16dp</dimen>

    <!-- Fixed-header Toolbar height for both activities. A little more compact
         than the platform's 56dp ?android:attr/actionBarSize to save vertical
         space, but not so tight that the Lookup SearchView's underline ends up
         flush against the toolbar's bottom edge (which happens at 48dp, the
         field's own natural height) - 52dp keeps a little breathing room below
         it. -->
    <dimen name="toolbar_height">52dp</dimen>

    <!-- Default sizes for Samsung multiwindow. -->
    <dimen name="app_defaultsize_w">632.0dip</dimen>
    <dimen name="app_defaultsize_h">598.0dip</dimen>
    <dimen name="app_minimumsize_w">632.0dip</dimen>
    <dimen name="app_minimumsize_h">598.0dip</dimen>

</resources>
