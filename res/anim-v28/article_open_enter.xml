<?xml version="1.0" encoding="utf-8"?>
<!-- API 28+ variant: identical to res/anim/article_open_enter (see there for the
     full rationale), but using the platform's own fast_out_extra_slow_in curve,
     which only exists from API 28. The base res/anim/ copy falls back to
     fast_out_slow_in (API 21+) so it doesn't crash on API 23-27. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <alpha
        android:fromAlpha="0.0"
        android:toAlpha="1.0"
        android:startOffset="50"
        android:duration="83"
        android:interpolator="@android:anim/linear_interpolator" />
    <translate
        android:fromXDelta="96dp"
        android:toXDelta="0"
        android:duration="@integer/article_transition_open_duration"
        android:interpolator="@android:interpolator/fast_out_extra_slow_in" />
</set>
