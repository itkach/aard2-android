<menu xmlns:android="http://schemas.android.com/apk/res/android"
      xmlns:app="http://schemas.android.com/apk/res-auto" >

    <!-- Shown as icons in the selection CAB. app:showAsAction is explicit because
         AppCompat's SupportMenuInflater builds this menu and defaults items to
         overflow; without it these would go to the overflow menu instead of
         showing on the bar. -->
    <item
        android:id="@+id/blob_descriptor_select_all"
        android:title="@android:string/selectAll"
        app:showAsAction="always"/>

    <item
        android:id="@+id/blob_descriptor_delete"
        android:title="@string/delete"
        app:showAsAction="always"
        />
</menu>
