<?xml version="1.0" encoding="utf-8"?>
<!-- The Bookmarks/History filter field, hosted as the action_filter menu item's
     collapsible action view. Our SearchField (icon + text + clear, thin
     underline) rather than a SearchView, so the funnel icon and the spacing are
     plain layout instead of reach-into-internals hacks. The toolbar stretches an
     action view to the full bar height, so a little vertical padding insets the
     field to centre it with the underline off the bottom edge, matching Lookup
     and find-in-page. Separate top/bottom (not paddingVertical, API 26+) for
     minSdk. -->
<itkach.aard2.SearchField
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fldFilter"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="4dp"
    android:paddingBottom="4dp" />
