<?xml version="1.0" encoding="utf-8"?>
<!-- Close ("done") button for the find-in-page ActionMode bar, wired in via
     closeItemLayout in Widget.Aard2.ActionMode. AppCompat's
     abc_action_mode_close_item_material with its 12dp start padding and 16dp end
     margin dropped: with the button at the Toolbar's 56dp navigation width (the
     style's minWidth) and the arrow centred, the find bar's back arrow lands
     exactly where the Toolbar's up arrow does, so it doesn't shift when find
     toggles in/out. The field's SearchField puts its own leading icon right at
     its start, so it sits snug after this button with no extra gap. The id must
     stay action_mode_close_button (AppCompat's ActionBarContextView finds the
     button by that id); srcCompat/style/contentDescription mirror the original. -->
<ImageView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@id/action_mode_close_button"
    style="?attr/actionModeCloseButtonStyle"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:clickable="true"
    android:contentDescription="?attr/actionModeCloseContentDescription"
    android:focusable="true"
    app:srcCompat="?attr/actionModeCloseDrawable" />
