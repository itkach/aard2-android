<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dictionary_item"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="8dip"
    android:paddingLeft="8dip"
    android:paddingRight="8dip"
    android:paddingTop="6dip">

    <!-- Collapsed row is this single line: on/off toggle (leading), name, and a
         trailing expand chevron + drag handle. The whole name+chevron span
         (dictionary_toggle_detail_area) toggles the details, not just the
         chevron. Favourite ("use in random lookup") and forget both live in the
         expanded details below. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="0dp"
        >
        <!-- The M3 switch has no compact variant, so it is scaled down for these
             dense rows. Scaling shrinks its touch area too, so the switch is not
             clickable itself and instead sits in this 48dp frame that owns the
             tap (and the ripple) and toggles it - small graphic, full-size
             target. -->
        <FrameLayout
            android:id="@+id/dictionary_active_touch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:layout_gravity="center_vertical"
            android:layout_weight="0"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/dictionary_active"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:checked="true"
                android:enabled="true"
                android:clickable="false"
                android:scaleX="0.75"
                android:scaleY="0.75" />
        </FrameLayout>
        <LinearLayout
            android:id="@+id/dictionary_toggle_detail_area"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <TextView
                android:id="@+id/dictionary_label"
                style="@style/TextAppearance.Aard2.ListTitle"
                android:textSize="20sp"
                android:text="WordNet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/dictionary_btn_toggle_detail"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"/>
        </LinearLayout>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/dictionary_btn_drag_handle"
            android:layout_gravity="center_vertical"
            android:contentDescription="@string/dictionary_drag_handle"
            android:paddingLeft="8dp"
            android:paddingRight="4dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dictionary_error_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        >

        <ImageView
            android:id="@+id/dictionary_error_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAlignBottom="true"
            android:layout_marginRight="4dp"
            android:layout_marginEnd="4dp"
            />

        <TextView
            android:id="@+id/dictionary_error"
            style="@style/TextAppearance.Aard2.ListCaption"
            android:text="File does not exist"
            android:textColor="?attr/colorError"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/dictionary_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:layout_marginLeft="16dp"
        >

        <TextView
            android:id="@+id/dictionary_blob_count"
            style="@style/TextAppearance.Aard2.ListCaption"
            android:text="100,000 items"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_marginBottom="6dp"
            />

        <LinearLayout
            android:id="@+id/dictionary_copyright_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="2dp"
            >

            <ImageView
                android:id="@+id/dictionary_copyright_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAlignBottom="true"
                android:layout_marginRight="4dp"
                android:layout_marginEnd="4dp"
                />

            <TextView
                android:id="@+id/dictionary_copyright"
                style="@style/TextAppearance.Aard2.ListSubtitle"
                android:text="2014 Wikipedia editors and contributors"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/dictionary_license_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="2dp"
            >
            <ImageView
                android:id="@+id/dictionary_license_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAlignBottom="true"
                android:layout_marginRight="4dp"
                android:layout_marginEnd="4dp"
                />
            <TextView
                android:id="@+id/dictionary_license"
                style="@style/TextAppearance.Aard2.ListSubtitle"
                android:text="Creative Commons with Attribution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="false"
                />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dictionary_source_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="2dp"
            >

            <ImageView
                android:id="@+id/dictionary_source_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAlignBottom="true"
                android:layout_marginRight="4dp"
                android:layout_marginEnd="4dp"
                />

            <TextView
                android:id="@+id/dictionary_source"
                style="@style/TextAppearance.Aard2.ListSubtitle"
                android:text="http://en.wikipedia.org"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/dictionary_path_row"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            >
            <ImageView
                android:id="@+id/dictionary_path_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAlignBottom="true"
                android:layout_marginRight="4dp"
                android:layout_marginEnd="4dp"
                />
            <TextView
                android:id="@+id/dictionary_path"
                style="@style/TextAppearance.Aard2.ListSubtitle"
                android:text="/mnt/sdcard/wordnet.slob"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="italic"
                />
        </LinearLayout>

        <!-- "Use for random lookup" (left) and forget (right) share the last
             row; both only appear when the row is expanded. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp"
            >
            <CheckBox
                android:id="@+id/dictionary_use_for_random"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/dictionary_use_for_random"
                />
            <ImageView
                android:id="@+id/dictionary_btn_forget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="12dp"
                android:paddingRight="4dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
