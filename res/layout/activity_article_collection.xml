<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/article_collection_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The article pager fills the whole window (edge to edge). Each page is
         an ArticleWebView that scrolls and flings entirely natively; the
         header below is slid to mirror the current WebView's scroll (see
         ArticleCollectionActivity). Content is kept below the header by top
         padding applied to each WebView at runtime, with clipToPadding=false
         so it scrolls up behind the header. -->
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Collapsing header: the Toolbar plus the always-visible swipe-title
         bar, stacked. Its top is offset below the status bar (topMargin set
         to the status bar inset at runtime) and it is slid up via
         translationY by exactly the TOOLBAR's height as the article scrolls -
         so the toolbar disappears behind the status bar scrim while the title
         bar comes to rest just below the status bar, staying fully visible. -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical">

        <android.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            android:background="?attr/colorPrimary"
            android:titleTextColor="?attr/colorOnPrimary"
            android:subtitleTextColor="?attr/colorOnPrimary"
            android:theme="@style/ThemeOverlay.Aard2.Toolbar"
            android:popupTheme="@style/ThemeOverlay.Aard2.ToolbarPopup" />

        <!-- Swipe-title bar (always visible): the faded prev | current | next
             strip, reflecting the pager. -->
        <itkach.aard2.ArticleTitleStrip
            android:id="@+id/article_title_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurfaceVariant"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />

    </LinearLayout>

    <!-- Opaque strip over the status bar area, drawn on top of the header so
         the toolbar slides up behind it. Height and color set at runtime
         (color follows the DEVICE's dark mode, matching the system status bar
         icons, not this app's own light/dark preference). -->
    <View
        android:id="@+id/status_bar_scrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top" />

</FrameLayout>
