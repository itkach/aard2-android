<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/article_collection_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Fixed header: the Toolbar, with AppBarLayout supplying the elevation
         shadow that separates it from the article content below.
         android:fitsSystemWindows="true" (on the AppBarLayout, NOT the
         Toolbar) is what lets AppBarLayout capture the status bar inset into
         its own lastInsets and reserve that space above the Toolbar - a plain
         gap painted by its statusBarForeground (color set at runtime in
         Application.applyStatusBarAppearance, which follows the DEVICE's dark
         mode so it matches the system-drawn status bar icons rather than this
         app's own light/dark preference). No manual top padding here: that
         would double the reserved inset. -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <android.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            android:background="?attr/colorPrimary"
            android:titleTextColor="?attr/colorOnPrimary"
            android:subtitleTextColor="?attr/colorOnPrimary"
            android:theme="@style/ThemeOverlay.Aard2.Toolbar"
            android:popupTheme="@style/ThemeOverlay.Aard2.ToolbarPopup" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- The article pager fills the rest of the window. Each page is an
         ArticleWebView whose content starts below the pager's title strip
         purely by layout - no WebView padding or injected CSS - so it works
         for every content type a WebView can display, not just HTML. The
         swipe-title strip is a direct child of the ViewPager (the only place
         PagerTitleStrip can live) and pins itself to the pager's top. -->
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.viewpager.widget.PagerTitleStrip
            android:id="@+id/pager_title_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="?attr/colorSurfaceVariant"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

    </androidx.viewpager.widget.ViewPager>

</LinearLayout>
