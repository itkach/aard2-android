#!/usr/bin/env bash
# Record which slobj/slobber revisions this commit was built against, and refuse
# the commit if either has uncommitted or untracked changes (the recorded HEAD
# would otherwise not reflect what's built). The dependency list, the dirty check,
# and the recording all live in `./d record-deps`; this hook is just the trigger
# and the staging. Bypass with `git commit --no-verify`.
root=$(git rev-parse --show-toplevel)
"$root/d" record-deps --require-clean || exit 1

# Stage the regenerated file into the commit - except during a partial commit
# (git commit -- <paths>, --only), where git builds a temporary index named
# next-index-<pid>; staging into that would sneak source-deps.json into a commit
# the user deliberately scoped. Whole-index commits (plain, -a, --include) use
# index / index.lock and are staged normally.
case "$(basename "${GIT_INDEX_FILE:-index}")" in
    next-index-*) exit 0 ;;
esac

git add "$root/source-deps.json" 2>/dev/null || true
exit 0
