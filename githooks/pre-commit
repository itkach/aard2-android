#!/usr/bin/env bash
# Keep source-deps.json in sync with the sibling dependency checkouts on every
# commit, so each commit records exactly which slobj/slobber it was built
# against. record-deps no-ops when the siblings aren't present, and this hook
# never blocks a commit if anything goes wrong.
root=$(git rev-parse --show-toplevel)
"$root/scripts/record-deps" || exit 0

# Stage the regenerated file into the commit - except during a partial commit
# (git commit -- <paths>, --only, -p, -i), where git builds a temporary index
# named next-index-<pid>; staging into that would sneak source-deps.json into a
# commit the user deliberately scoped, so leave it unstaged then. Whole-index
# commits (plain, -a, --include) use index / index.lock and are staged normally.
case "$(basename "${GIT_INDEX_FILE:-index}")" in
    next-index-*) exit 0 ;;
esac

git add "$root/source-deps.json" 2>/dev/null || true
exit 0
